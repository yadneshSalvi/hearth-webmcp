# Copy to .env and fill in. Server-only values are read in app/api/**, scripts/** and src/shopify/server.ts.

# Shopify (SHOPIFY.md) — development store, Storefront API 2026-07
SHOPIFY_STORE_DOMAIN=hearth-studio.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PASSWORD=

# Fallback in-page assistant (app/api/assistant) — OpenAI Responses API
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-5.6-sol
ASSISTANT_REASONING_EFFORT=high

# Optional: Anthropic backend for webmcp-evals
ANTHROPIC_API_KEY=

# Optional: Gemini (video narration TTS; scripts only)
GEMINI_API_KEY=

# Chrome WebMCP origin-trial token for the production origin (rendered as <meta http-equiv="origin-trial">)
ORIGIN_TRIAL_TOKEN=

# Public site URL (metadata)
NEXT_PUBLIC_SITE_URL=https://hearth.yadneshsalvi.com

# Floor-plan reader (app/api/floorplan): defaults to ASSISTANT_MODEL and medium reasoning.
PLAN_READER_MODEL=
PLAN_READER_REASONING_EFFORT=
